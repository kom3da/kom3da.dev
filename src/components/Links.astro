---
import { isEmail, profile } from "../lib/profile";
import Prompt from "./Prompt.astro";

const rows = [
  ...profile.links
    .filter((l) => !isEmail(l))
    .map((l) => ({
      label: l.label.toLowerCase(),
      meta: l.handle ?? l.url,
      url: l.url,
      external: true,
    })),
  { label: "llms.txt", meta: "for AI agents", url: "/llms.txt", external: false },
];
---

<nav
  id="links"
  aria-labelledby="links-title"
  data-reveal
  class="relative flex flex-col gap-[18px] border-b border-line px-4 py-10 lg:flex-[1_1_340px] lg:gap-5 lg:border-r lg:border-b-0 lg:px-12 lg:py-12"
>
  <div class="edge" aria-hidden="true"></div>
  <h2 id="links-title" class="text-[11px] font-medium tracking-[0.08em] text-muted lg:text-xs">
    01 — LINKS
  </h2>
  <Prompt command="ls links/" />
  <ul class="rise flex flex-col border-t border-line" style="--d: 2">
    {
      rows.map((row) => (
        <li>
          <a
            href={row.url}
            class="row flex justify-between border-b border-line px-1 py-3.5 lg:px-0 lg:py-[13px]"
            {...(row.external && { target: "_blank", rel: "noopener noreferrer" })}
          >
            <span>{row.label}</span>
            <span class="text-muted">{row.meta} ↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
