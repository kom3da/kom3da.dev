---
import { groupSkills, profile } from "../lib/profile";
import Prompt from "./Prompt.astro";

const groups = groupSkills(profile.skills);
---

<section
  id="skills"
  aria-labelledby="skills-title"
  data-reveal
  class="flex flex-col gap-[18px] px-4 py-10 lg:flex-[2.2_1_520px] lg:gap-5 lg:px-12 lg:py-12"
>
  <h2 id="skills-title" class="text-[11px] font-medium tracking-[0.08em] text-muted lg:text-xs">
    02 — SKILLS
  </h2>
  <Prompt command="tree skills/" delay={2} />
  <div class="rise flex flex-col gap-4 lg:gap-3" style="--d: 4">
    {
      groups.map(([category, skills], i) => (
        <div class="flex flex-col gap-1.5 lg:flex-row lg:items-baseline lg:gap-2.5">
          <h3 class="whitespace-nowrap text-muted lg:w-[20ch] lg:shrink-0">
            {i === groups.length - 1 ? "└──" : "├──"} {category.toLowerCase()}/
          </h3>
          <ul class="flex flex-wrap gap-1.5 pl-7 lg:pl-0">
            {skills.map((skill) => (
              <li id={`skill-${skill.id}`} class="chip">
                {skill.name}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
