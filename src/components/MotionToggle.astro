---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<!-- Pauses the looping animations (ticker, pane glow); label is synced by site.ts -->
<button
  type="button"
  data-motion-toggle
  aria-pressed="true"
  class:list={["cursor-pointer text-muted hover:text-lime", className]}
>
  motion: on
</button>
