---
import { profile } from "../lib/profile";

const [firstRole, ...otherRoles] = profile.jobTitle.split(" / ");
const handle = new URL(profile.url).hostname.split(".")[0];
---

<section
  id="about"
  aria-labelledby="name"
  class="mx-auto flex w-full max-w-[1360px] flex-col gap-6 px-4 pt-14 pb-12 lg:gap-7 lg:px-10 lg:pt-24 lg:pb-20"
>
  <p class="text-[11px]/[1.6] tracking-[0.08em] text-lime lg:text-[13px]">
    // {firstRole.toUpperCase()}
    {
      otherRoles.map((role) => (
        <>
          <br class="lg:hidden" /> × {role.toUpperCase()}
        </>
      ))
    }
  </p>
  <p aria-hidden="true" class="prompt">
    <span class="text-dim">$</span><span class="type ml-[0.2em]" style={`--n: ${handle.length}`}>{handle}</span><span class="cursor"></span>
  </p>
  <div class="flex max-w-[680px] flex-col gap-2 lg:gap-2.5">
    <h1 id="name" class="text-[19px] font-bold tracking-[-0.02em] lg:text-2xl">
      {profile.nameEn}{" "}
      <span class="font-jp text-sm font-normal text-muted lg:text-base">{profile.name}</span>
    </h1>
    <p class="mt-1.5 font-jp text-[15px]/[1.9] text-body lg:mt-0 lg:text-base/[1.9]">
      {profile.bio}
    </p>
  </div>
</section>
