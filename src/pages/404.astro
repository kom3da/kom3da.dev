---
import Base from "../layouts/Base.astro";
---

<Base title="404 Not Found | kom3da.dev" description="Page not found" noindex>
  <main class="mx-auto flex w-full max-w-[1360px] flex-1 flex-col justify-center gap-6 px-4 py-16 lg:px-10">
    <p class="text-muted"><span class="text-lime">~</span> $ cd ./this-page</p>
    <h1 class="text-[clamp(64px,18vw,184px)] leading-[0.9] font-extrabold tracking-[-0.07em]">
      404
    </h1>
    <p class="text-muted">zsh: no such file or directory</p>
    <a href="/" class="text-lime">cd ~ →</a>
  </main>
</Base>
