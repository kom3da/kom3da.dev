{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kom3da-dev",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "kom3da.dev", "custom_domain": true },
    { "pattern": "www.kom3da.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Array patterns break asset MIME types; route everything through the worker
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
